```gitignore
# ==============================
# Python bytecode and caches
# ==============================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ==============================
# Virtual environments
# ==============================
.venv/
venv/
ENV/
env/

# ==============================
# Trained model checkpoints
# ==============================
models/job_ner_model/checkpoint-*/

# ==============================
# Environment variables and secrets
# ==============================
.env
.env.*
!.env.example

# ==============================
# Logs and temporary files
# ==============================
*.log
*.tmp
*.bak

# ==============================
# Editor and operating system files
# ==============================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
```
